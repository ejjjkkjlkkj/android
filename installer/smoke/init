#!/bin/sh
set -eu

export PATH=/bin

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Do not make PID 1 depend on a VMware/QEMU-specific serial device. The kernel
# already starts init with /dev/console attached to stdin/stdout/stderr. Some
# VMware profiles expose no ttyS0 at all; forcing redirection to /dev/ttyS0
# makes the init script exit and produces "Attempted to kill init".
if [ -c /dev/ttyS0 ]; then
  echo "SMOKE_CONSOLE_DEVICE=/dev/ttyS0"
elif [ -c /dev/tty0 ]; then
  echo "SMOKE_CONSOLE_DEVICE=/dev/tty0"
elif [ -c /dev/console ]; then
  echo "SMOKE_CONSOLE_DEVICE=/dev/console"
else
  echo "SMOKE_CONSOLE_DEVICE=INHERITED"
fi

echo
echo "ACCESSIBLE_ANDROID_KERNEL_BOOT=PASS"
echo "AccessibleAndroid kernel smoke environment is running."
echo "This console is intentionally text-only and screen-reader friendly."
echo "Kernel:"
cat /proc/version || true
echo "CPU:"
grep -m1 -E 'model name|Hardware' /proc/cpuinfo || true
echo "Available block devices:"
ls /sys/class/block 2>/dev/null || true
echo "SMOKE_CONSOLE=READY"
echo "Type 'poweroff -f' to stop the virtual machine."

exec /bin/sh
