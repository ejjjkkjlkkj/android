# Deterministic serial milestones for automated VM validation.
# These messages are emitted by Android init itself and therefore prove that the
# boot reached specific Android userspace phases rather than only GRUB/kernel.

on post-fs-data
    write /dev/ttyS0 ACCESSIBLE_ANDROID_POST_FS_DATA=PASS

on property:sys.boot_completed=1
    write /dev/ttyS0 ACCESSIBLE_ANDROID_FRAMEWORK_BOOT=PASS

# Userdebug/eng validation path: prove that the devices presented by QEMU are
# actually visible from inside Android. The probe writes a final PASS marker to
# ttyS0 only after disk/rng/network PCI, DRM, virtio-snd and accessible input
# checks all succeed. Production user builds do not run this diagnostic probe.
on property:sys.boot_completed=1 && property:ro.debuggable=1
    exec_background u:r:su:s0 -- /system/bin/sh /vendor/etc/accessible-vm-hardware-probe.sh
