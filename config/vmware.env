# AccessibleAndroid VMware Workstation hardware contract.
# This profile is intentionally independent from the QEMU/virtio reference profile.

VMWARE_PROFILE=workstation
VMWARE_FIRMWARE=efi
VMWARE_MEMORY_MIB=8192
VMWARE_CPUS=6
VMWARE_DISK_CONTROLLER=pvscsi
VMWARE_NETWORK_ADAPTER=vmxnet3
VMWARE_GRAPHICS_ADAPTER=vmwgfx
VMWARE_AUDIO_PRIMARY=hdaudio
VMWARE_AUDIO_FALLBACK=ens1371
VMWARE_USB_CONTROLLER=xhci
VMWARE_GUEST_OS=other6xlinux-64

# Kernel features that must be built in for boot-critical VMware hardware.
# Keeping PVSCSI/AHCI/NVMe built-in prevents first-stage init from losing the OS disk.
VMWARE_BOOT_BUILTINS=CONFIG_SCSI_VMW_PVSCSI,CONFIG_SATA_AHCI,CONFIG_BLK_DEV_NVME,CONFIG_SERIO_I8042,CONFIG_HID_GENERIC,CONFIG_USB_HID

# Runtime VMware devices and compatibility fallbacks.
VMWARE_RUNTIME_BUILTINS=CONFIG_DRM_VMWGFX,CONFIG_VMXNET3,CONFIG_E1000,CONFIG_E1000E,CONFIG_VMWARE_VMCI,CONFIG_VSOCKETS,CONFIG_VMWARE_VMCI_VSOCKETS,CONFIG_SND_HDA_INTEL,CONFIG_SND_ENS1371,CONFIG_USB_XHCI_HCD

# Android userspace contracts checked after boot.
VMWARE_REQUIRED_RUNTIME_NODES=/dev/dri/card0,/dev/snd
VMWARE_REQUIRED_FEATURES=graphics,audio,network,keyboard,mouse,usb,storage,accessibility
