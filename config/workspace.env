# Shared workspace layout for every build and validation script.
# The caller must set PROJECT_ROOT to the repository root before sourcing this file.

: "${PROJECT_ROOT:?PROJECT_ROOT must be set before sourcing config/workspace.env}"

AOSP_DIR="${AOSP_DIR:-$PROJECT_ROOT/.work/aosp}"
ACCESSIBILITY_SRC_DIR="${ACCESSIBILITY_SRC_DIR:-$PROJECT_ROOT/.work/accessibility-src}"
ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$PROJECT_ROOT/.work/android-sdk}}"
KERNEL_SRC_DIR="${KERNEL_SRC_DIR:-$PROJECT_ROOT/.work/kernel}"
KERNEL_DIST_DIR="${KERNEL_DIST_DIR:-$PROJECT_ROOT/.work/kernel-dist}"
VM_ARTIFACT_DIR="${VM_ARTIFACT_DIR:-$PROJECT_ROOT/.work/vm}"
BUILD_LOG_DIR="${BUILD_LOG_DIR:-$PROJECT_ROOT/.work/logs}"

export AOSP_DIR
export ACCESSIBILITY_SRC_DIR
export ANDROID_SDK_ROOT
export KERNEL_SRC_DIR
export KERNEL_DIST_DIR
export VM_ARTIFACT_DIR
export BUILD_LOG_DIR
