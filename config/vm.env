# Deterministic QEMU hardware contract shared by boot/install/test scripts.
# Keep these values stable once installable images are published.

VM_MACHINE=q35
VM_MEMORY_MIB=4096
VM_CPUS=4

# Primary Android installation disk. QEMU command lines must use:
#   -drive if=none,id=osdisk,...
#   -device virtio-blk-pci,drive=osdisk,bus=pcie.0,addr=0x6
VM_OS_DISK_ID=osdisk
VM_OS_DISK_PCI_ADDR=0x6
ANDROID_BOOT_DEVICES=pci0000:00/0000:00:06.0

# Initial sparse raw disk envelope. userdata consumes the remaining GPT space
# in the final installer; preview/preinstalled builders may use a fixed size.
VM_DISK_SIZE_GIB=16
VM_ESP_SIZE_MIB=256
VM_METADATA_SIZE_MIB=64
VM_MISC_SIZE_MIB=4
