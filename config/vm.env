# Deterministic QEMU hardware and disk contract shared by boot/install/test scripts.
# Keep these values stable once installable images are published.

VM_MACHINE=q35
VM_MEMORY_MIB=4096
VM_CPUS=4

# Primary Android installation disk. QEMU command lines must use:
#   -drive if=none,id=osdisk,...
#   -device virtio-blk-pci,drive=osdisk,bus=pcie.0,addr=0x6
VM_OS_DISK_ID=osdisk
VM_OS_DISK_PCI_ADDR=0x6
ANDROID_BOOT_DEVICES=pci0000:00/0000:00:06.0

# First reproducible preinstalled image. The production installer can later grow
# userdata to consume a larger destination disk, but this geometry is fixed so
# BIOS/UEFI boot and Android first-stage mount can be tested deterministically.
VM_DISK_SIZE_GIB=16
VM_BIOS_GRUB_SIZE_MIB=2
VM_ESP_SIZE_MIB=256
VM_BOOT_SIZE_MIB=64
VM_INIT_BOOT_SIZE_MIB=8
VM_VENDOR_BOOT_SIZE_MIB=64
VM_VBMETA_SIZE_MIB=1
VM_SUPER_SIZE_MIB=7168
VM_METADATA_SIZE_MIB=64
VM_MISC_SIZE_MIB=4
VM_USERDATA_SIZE_MIB=8192

# Stable GPT labels. Android fs_mgr resolves the A/B labels through slotselect.
VM_GPT_LABEL_BIOS_GRUB=bios_grub
VM_GPT_LABEL_ESP=esp
VM_GPT_LABEL_BOOT_A=boot_a
VM_GPT_LABEL_BOOT_B=boot_b
VM_GPT_LABEL_INIT_BOOT_A=init_boot_a
VM_GPT_LABEL_INIT_BOOT_B=init_boot_b
VM_GPT_LABEL_VENDOR_BOOT_A=vendor_boot_a
VM_GPT_LABEL_VENDOR_BOOT_B=vendor_boot_b
VM_GPT_LABEL_VBMETA_A=vbmeta_a
VM_GPT_LABEL_VBMETA_B=vbmeta_b
VM_GPT_LABEL_SUPER=super
VM_GPT_LABEL_METADATA=metadata
VM_GPT_LABEL_MISC=misc
VM_GPT_LABEL_USERDATA=userdata
