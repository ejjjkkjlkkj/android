# AccessibleQEMU engine baseline.
# Keep the engine on an official stable QEMU release and review UTM changes individually.

QEMU_UPSTREAM_REPOSITORY=https://github.com/qemu/qemu.git
QEMU_UPSTREAM_TAG=v11.1.1
QEMU_UPSTREAM_REV=c3d48b7d1e89604920e5b81b91140c2ad39a1943

# Candidate UTM patch not yet accepted into the engine. It addresses virtio-gpu
# control-queue stalls during hostmem blob unmap. It must apply and pass QEMU
# build/tests on the pinned official baseline before it can be enabled.
QEMU_UTM_CANDIDATE_BLOB_UNMAP_REV=3bdba2ae2ed1158b9fc9822562d86b8e287d8490
QEMU_UTM_CANDIDATE_BLOB_UNMAP_STATE=review
