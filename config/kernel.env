# Official Android Common Kernel source for the AccessibleAndroid VM profile.
# The monthly manifest branch is synchronized and then frozen with repo manifest -r.

KERNEL_MANIFEST_URL=https://android.googlesource.com/kernel/manifest
KERNEL_MANIFEST_BRANCH=common-android17-6.18-2026-09
KERNEL_FAMILY=android17-6.18
KERNEL_ARCH=x86_64
KERNEL_BUILD_TARGET=//common-modules/virtual-device:virtual_device_x86_64
KERNEL_DIST_TARGET=//common-modules/virtual-device:virtual_device_x86_64_dist
KERNEL_IMAGE_NAME=bzImage
# Keep this list limited to loadable VM modules that must exist in every
# supported Android 17 virtual-device dist. PCI helper modules such as
# virtio_pci_modern_dev.ko and virtio_pci_legacy_dev.ko vary with kernel
# packaging/configuration; BoardConfig stages them into vendor_boot when they
# exist, but they are intentionally not hard build requirements.
# The first three modules are boot-critical: PCI transport, the virtio-blk OS
# disk, and early entropy.
KERNEL_REQUIRED_VM_MODULES=virtio_pci.ko,virtio_blk.ko,virtio-rng.ko,virtio-gpu.ko,virtio_dma_buf.ko,virtio_input.ko,virtio_net.ko,virtio_snd.ko
