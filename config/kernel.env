# Official Android Common Kernel source for the AccessibleAndroid VM profile.
# The monthly manifest branch is synchronized and then frozen with repo manifest -r.

KERNEL_MANIFEST_URL=https://android.googlesource.com/kernel/manifest
KERNEL_MANIFEST_BRANCH=common-android17-6.18-2026-09
KERNEL_FAMILY=android17-6.18
KERNEL_ARCH=x86_64
KERNEL_BUILD_TARGET=//common-modules/virtual-device:virtual_device_x86_64
KERNEL_DIST_TARGET=//common-modules/virtual-device:virtual_device_x86_64_dist
KERNEL_IMAGE_NAME=bzImage
# Only list loadable VM modules that the official virtual-device x86_64 dist
# actually exports as .ko files. The GKI bzImage provides the core VirtIO PCI
# transport and block driver directly, so virtio_pci.ko and virtio_blk.ko are
# deliberately not hard requirements. PCI helper modules can also vary with
# kernel packaging and remain optional in BoardConfig.
KERNEL_REQUIRED_VM_MODULES=virtio-rng.ko,virtio-gpu.ko,virtio_dma_buf.ko,virtio_input.ko,virtio_net.ko,virtio_snd.ko
